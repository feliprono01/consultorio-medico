# ============================================
# Variables de entorno para Docker
# Copiar este archivo a .env y completar
# NUNCA subir .env a GitHub (ya está en .gitignore)
# ============================================

# Base de datos
DB_PASSWORD=tu_password_db_seguro

# Admin inicial (solo se crea si no existe en la DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TuPasswordSeguro1234!

# JWT — generar una clave aleatoria segura para producción
# PowerShell: -join ((1..64) | ForEach-Object { '{0:X2}' -f (Get-Random -Min 0 -Max 256) })
JWT_SECRET=reemplazar_con_clave_hex_segura_de_256_bits
JWT_EXPIRATION=86400000

# Email (para backups automáticos)
SPRING_MAIL_USERNAME=tu_email@gmail.com
SPRING_MAIL_PASSWORD=tu_app_password_gmail

# Usuario MySQL dedicado (Paso 6 de hardening)
DB_USER=consultorio_user
